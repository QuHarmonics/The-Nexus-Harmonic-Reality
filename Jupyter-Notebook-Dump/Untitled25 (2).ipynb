   ],
   "source": [
    "def sum_of_digits(number: int) -> int:\n",
    "    return sum(int(digit) for digit in str(abs(number)))\n",
    "\n",
    "# Example usage\n",
    "num = int(input(\"Enter a number: \"))\n",
    "print(\"Sum of digits:\", sum_of_digits(num))"
   ]
