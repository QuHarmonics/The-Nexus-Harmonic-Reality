def compute_color(vec):
    # Generate RGB from vector direction, scaled and bounded
    r = min(255, max(0, int(abs(vec[0]))))
    g = min(255, max(0, int(abs(vec[1]))))
    b = 255 - int((r + g) / 2)
    return f"rgb({r},{g},{b})"

