  "source_rejection_tests": [
    {
      "case": "wrong word width",
      "expected": "SourceError",
      "actual": "SourceError",
      "message": "every state must contain exactly 3 bits",
      "passed": true
    },
    {
      "case": "duplicate/missing state",
      "expected": "SourceError",
      "actual": "SourceError",
      "message": "duplicate or missing state",
      "passed": true
    },
    {
      "case": "ordinary counting order instead of ring order",
      "expected": "SourceError",
      "actual": "SourceError",
      "message": "cycle differs from the original ring ordering or center swap",
      "passed": true
    },
    {
      "case": "nonbinary state token",
      "expected": "GrammarError",
      "actual": "GrammarError",
      "message": "description must be a binary cycle or a fold packet",
      "passed": true
    },
    {
      "case": "fold reference has wrong width",
      "expected": "FoldError",
      "actual": "FoldError",
      "message": "reference 0 must have 3 bits, got 2",
      "passed": true
    },
    {
      "case": "fold references discarded",
      "expected": "FoldError",
      "actual": "FoldError",
      "message": "unfolded tape must have 24 bits, got 3",
      "passed": true
    },
    {
      "case": "fold root not a terminal equal-half residue",
      "expected": "FoldError",
      "actual": "FoldError",
      "message": "root is not a terminal equal-half residual",
      "passed": true
    },
    {
      "case": "zero source width",
      "expected": "SourceError",
      "actual": "SourceError",
      "message": "width must be positive",
      "passed": true
    },
    {
      "case": "malformed source header",
      "expected": "GrammarError",
      "actual": "GrammarError",
      "message": "expected ring NAME width INTEGER { description }",
      "passed": true
    }
  ],
  "resource_policy_test": {
    "case": "valid-width-13 ring exceeds implementation budget",
    "expected": "ResourceLimit",
    "actual": "ResourceLimit",
    "message": "reference implementation width cap is 12",
    "passed": true
  },
  "runtime_rejection_tests": [
    {
