(* Grammar of the Boolean kernels embedded in generated Python.
   The host wrapper supplies input guards, bit extraction and output packing. *)
kernel         = { product_binding }, output_binding, { output_binding } ;
product_binding = gate_name, "=", bit_name, "&", bit_name,
                  { "&", bit_name } ;
output_binding = output_name, "=", xor_expression ;
xor_expression = atom, { "^", atom } ;
atom           = "0" | "1" | bit_name | gate_name ;
bit_name       = "a" | "b" | "c" | "d" | "e" | "f" |
                 "g" | "h" | "i" | "j" | "k" | "l" ;
gate_name      = "g", uint ;
output_name    = "y", uint ;
(* Bits are 0/1; ^ is XOR; & is AND. A product may be shared by outputs.
   The semantic IR stores ANF masks before this common-term naming pass. *)
